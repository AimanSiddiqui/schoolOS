# Copy to .env for local development. Values are development defaults only.

POSTGRES_DB=schoolos
POSTGRES_USER=schoolos
POSTGRES_PASSWORD=schoolos_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://schoolos:schoolos_dev_password@db:5432/schoolos
SCHOOLOS_ENVIRONMENT=local
SCHOOLOS_CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=schoolos_session
SESSION_DAYS=30
SECURE_COOKIES=false

NEXT_PUBLIC_API_BASE_URL=/api/backend
API_INTERNAL_URL=http://backend:8000

N8N_PORT=5678
N8N_BASIC_AUTH_USER=schoolos
N8N_BASIC_AUTH_PASSWORD=schoolos_dev_password

MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
